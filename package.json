{
  "name": "markup-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "MarkUP — a Markdown-compatible markup language with components, plus its parser, renderers, CLI, VS Code extension and desktop editor.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturjoaodaros-dev/MarkUP.git"
  },
  "homepage": "https://markup.rweb.site/",
  "bugs": {
    "url": "https://github.com/arturjoaodaros-dev/MarkUP/issues"
  },
  "workspaces": [
    "packages/core",
    "packages/html",
    "packages/text",
    "packages/language-service",
    "packages/language-server",
    "packages/cli",
    "packages/vscode",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:generate": "node --conditions=source scripts/generate-docs.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "docs:check": "node --conditions=source scripts/generate-docs.ts --check",
    "site": "node --conditions=source scripts/site/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
