{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run package -w markup-lang && npm run site",
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://gc.zgo.at; connect-src 'self' https://markup.goatcounter.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download.html",
      "destination": "/installation.html",
      "permanent": true
    },
    {
      "source": "/getting-started.html",
      "destination": "/quick-start.html",
      "permanent": true
    },
    {
      "source": "/downloads/:file(MarkUP-.+|SHA256SUMS[.]txt)",
      "destination": "https://github.com/arturjoaodaros-dev/MarkUP/releases/latest/download/:file",
      "permanent": false
    }
  ]
}
