{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkUP",
  "version": "0.1.0",
  "identifier": "dev.markup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkUP",
        "width": 1320,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#111318",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A focused editor for MarkUP documents.",
    "fileAssociations": [
      {
        "ext": ["markup", "mkup"],
        "name": "MarkUP document",
        "description": "MarkUP document",
        "role": "Editor",
        "mimeType": "text/markup"
      }
    ]
  }
}
