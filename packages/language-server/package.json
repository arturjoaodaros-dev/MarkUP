{
  "name": "@markup-lang/language-server",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for MarkUP (VS Code, Neovim, Helix, Zed…).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturjoaodaros-dev/MarkUP.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://markup.rweb.site/",
  "bugs": {
    "url": "https://github.com/arturjoaodaros-dev/MarkUP/issues"
  },
  "bin": {
    "markup-language-server": "dist/server.cjs"
  },
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "default": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@markup-lang/core": "0.1.0",
    "@markup-lang/language-service": "0.1.0",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14"
  }
}
