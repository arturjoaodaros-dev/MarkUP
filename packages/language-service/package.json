{
  "name": "@markup-lang/language-service",
  "version": "0.1.0",
  "description": "Editor-agnostic MarkUP language features: completion, hover, outline, folding, highlighting, navigation and quick fixes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturjoaodaros-dev/MarkUP.git",
    "directory": "packages/language-service"
  },
  "homepage": "https://markup.rweb.site/",
  "bugs": {
    "url": "https://github.com/arturjoaodaros-dev/MarkUP/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@markup-lang/core": "0.1.0"
  }
}
