{
  "name": "@markup-lang/html",
  "version": "0.1.0",
  "description": "HTML renderer for MarkUP: components, SVG charts and a shared theme.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturjoaodaros-dev/MarkUP.git",
    "directory": "packages/html"
  },
  "homepage": "https://markup.rweb.site/",
  "bugs": {
    "url": "https://github.com/arturjoaodaros-dev/MarkUP/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scroll-sync": {
      "source": "./src/scroll-sync.ts",
      "types": "./dist/scroll-sync.d.ts",
      "default": "./dist/scroll-sync.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@markup-lang/core": "0.1.0"
  }
}
