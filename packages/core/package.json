{
  "name": "@markup-lang/core",
  "version": "0.1.0",
  "description": "MarkUP language core: parser, AST, directive specs, data syntax, schema validation and diagnostics.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturjoaodaros-dev/MarkUP.git",
    "directory": "packages/core"
  },
  "homepage": "https://markup.rweb.site/",
  "bugs": {
    "url": "https://github.com/arturjoaodaros-dev/MarkUP/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
